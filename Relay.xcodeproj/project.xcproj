{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "Secrets.xcconfig" },
    { "name": "Release", "file": "Secrets.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "de",
      "en-CA",
      "en-GB",
      "es",
      "fr",
      "fr-CA",
      "ja",
      "vi",
      "zh-Hans",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "Packages/RelayShared",
    }, {
      "kind": "remote",
      "repository": "https://github.com/livekit/client-sdk-swift",
      "version": {
        "up-to-next-major-version": "2.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/danielsaidi/EmojiKit",
      "version": {
        "up-to-next-major-version": "3.0.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/subpop/MatrixKit",
      "version": {
        "branch": "main",
      },
    },
  ],
  "files": [
    { "path": "Secrets.xcconfig" },
    { "path": "README.md" },
    { "path": "CONTRIBUTING.md" },
    {
      "kind": "folder",
      "path": "Relay",
      "target-membership": [
        "Relay",
      ],
      "membership-exceptions": [
        {
          "target": "Relay",
          "exclusions": [
            "Info.plist",
          ],
        }, {
          "target": "RelayShareExtension",
          "inclusions": [
            "Utilities/StableNameColor.swift",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "RelayTests", "target-membership": [ "RelayTests" ] },
    {
      "kind": "folder",
      "path": "RelayShareExtension",
      "target-membership": [
        "RelayShareExtension",
      ],
      "membership-exceptions": [
        {
          "target": "RelayShareExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/Intents.framework", "target-membership": [ "RelayShareExtension/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Relay.app", "id": "3B4AFD892F638A35001F0EA1", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/RelayTests.xctest", "id": "3B11E0882F9A3F600051F7B3", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/RelayShareExtension.appex", "id": "3B3B82B82FC69A9F008DCEDC", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Relay/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Relay",
      "id": "3B4AFD882F638A35001F0EA1",
      "product": "Products/Relay.app",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": "Secrets.xcconfig" },
        { "name": "Release", "file": "Secrets.xcconfig" },
      ],
      "dependencies": [
        "RelayShareExtension",
      ],
      "build-phases": [
        {
          "kind": "script",
          "name": "Generate Secrets",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/Secrets.xcconfig",
            "$(SRCROOT)/scripts/generate-secrets.sh",
          ],
          "output-paths": [
            "$(SRCROOT)/Relay/Generated/Secrets.swift",
          ],
          "shell": "/bin/bash",
          "script": "\"${SRCROOT}/scripts/generate-secrets.sh\"\n",
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Index Help Book",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/scripts/index-help-book.sh",
            "$(BUILT_PRODUCTS_DIR)/$(FULL_PRODUCT_NAME)/Contents/Resources/Relay.help/Contents/Resources/en.lproj",
          ],
          "output-paths": [
            "$(BUILT_PRODUCTS_DIR)/$(FULL_PRODUCT_NAME)/Contents/Resources/Relay.help/Contents/Resources/en.lproj/Relay.helpindex",
            "$(BUILT_PRODUCTS_DIR)/$(FULL_PRODUCT_NAME)/Contents/Resources/Relay.help/Contents/Resources/en.lproj/Relay.cshelpindex",
          ],
          "run-on-every-build": true,
          "shell": "/bin/bash",
          "script": "\"${SRCROOT}/scripts/index-help-book.sh\"\n",
        }, {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "MatrixKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MatrixKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MatrixKit",
          "build-phase": { "build-phase": "frameworks" },
