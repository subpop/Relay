          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MatrixKitCrypto",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MatrixKitCrypto",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MatrixKitCrypto",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MatrixKitCrypto",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MatrixKitCrypto",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MatrixKitSwiftData",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MatrixKitSwiftData",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MatrixKitSwiftData",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MatrixKitSwiftData",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MatrixKitSwiftData",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MatrixRTC",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MatrixRTC",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MatrixRTC",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MatrixRTC",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MatrixRTC",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "EmojiKit",
          "product-name": "EmojiKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "MatrixKit",
          "product-name": "MatrixKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "MatrixKit",
          "product-name": "MatrixKitCrypto",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "MatrixKit",
          "product-name": "MatrixKitSwiftData",
          "build-phase": { "build-phase": "frameworks" },
        }, {
